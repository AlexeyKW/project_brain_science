{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brain.example/schema/common.schema.json",
  "title": "Common front-matter (все типы карточек)",
  "description": "Общий front-matter всех карточек Research Brain. Спецификация §3.",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "type", "status", "trust", "confidence", "author", "created"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(C|H|D|E|F|DS|L|M)-[0-9]{3}$",
      "description": "Постоянный ID: одна сущность = один файл"
    },
    "type": {
      "type": "string",
      "enum": ["claim", "hypothesis", "decision", "experiment", "failure", "dataset", "note"]
    },
    "status": {
      "type": "string",
      "enum": ["proposed", "active", "accepted", "completed", "supported", "contested", "retracted", "superseded", "planned"]
    },
    "trust": {
      "type": "string",
      "enum": ["ai-inferred", "machine-verified", "human-verified", "published"],
      "description": "Лестница доверия §4; агент не может повысить уровень сам"
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "author": {
      "type": "string",
      "pattern": "^(human:.+|agent:.+|agent-role:.+)$",
      "description": "agent:<model>@<date> | agent-role:<роль> | human:<id>"
    },
    "reviewed_by": {
      "type": ["string", "null"],
      "description": "только человек, через подписанный коммит"
    },
    "created": { "type": "string", "format": "date" },
    "valid_until": { "type": "string", "format": "date" },
    "supersedes": { "type": ["string", "array", "null"], "items": { "type": "string" } },
    "superseded_by": { "type": ["string", "null"] },
    "tags": { "type": "array", "items": { "type": "string" }, "maxItems": 8 }
  }
}
