#!/usr/bin/env python
# pre-commit hook: быстрая проверка перед коммитом (полная — в CI).
# Установка: cp .brain/hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
import subprocess, sys

def fail(msg):
    print(f"[brain pre-commit] FAIL: {msg}")
    sys.exit(1)

out = subprocess.run(
    [sys.executable, "src/validate_brain.py", "--brain", ".brain", "--fast"],
    capture_output=True, text=True,
)
print(out.stdout)
if out.returncode != 0:
    print(out.stderr)
    fail("валидация карточек не пройдена — см. выше")

print("[brain pre-commit] OK")
